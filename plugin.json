{
  "id": "claudeSwap",
  "name": "Claude Swap",
  "description": "Switch between Claude Code accounts (claude-swap): per-account usage, one-click switching and optional auto switch when quota runs out.",
  "version": "0.4.0",
  "author": "Henrique Barbosa",
  "type": "widget",
  "capabilities": [
    "dankbar-widget"
  ],
  "component": "./ClaudeSwapWidget.qml",
  "settings": "./ClaudeSwapSettings.qml",
  "icon": "swap_horiz",
  "requires_dms": ">=2.1.0",
  "dependencies": [
    "claude-swap",
    "claude",
    "flock"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ],
  "screenshot": "https://raw.githubusercontent.com/hfb0/dms-claude-swap/main/docs/screenshot.png",
  "screenshots": [
    "https://raw.githubusercontent.com/hfb0/dms-claude-swap/main/docs/screenshot.png"
  ]
}
